doctype html
html
  head
    meta(charset="UTF-8")
    title Movie catalog

    link(rel='stylesheet', href='/stylesheets/style.css')
    link(
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
          crossorigin="anonymous"
        )    
    script(src="/javascripts/delete.movie.js")
  body
    //- Bootstrap Navbar
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.mb-4
      .container-fluid
        a.navbar-brand(href='/') Movie catalog
        button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navbarNav', aria-controls='navbarNav', aria-expanded='false', aria-label='Toggle navigation')
          span.navbar-toggler-icon
        #navbarNav.collapse.navbar-collapse
          ul.navbar-nav.ms-auto
            li.nav-item
              a.nav-link(href='/movies') Movies
            li.nav-item
              a.nav-link(href='/about') About
            if authenticated == true
              li.nav-item
                a.btn.btn-outline-light.ms-2(href='/auth/logout') Logout
            else
              li.nav-item
                a.btn.btn-outline-success.ms-2(href='/auth/login') Login

    //- Main content
    .container
      if success
        .alert.alert-success.alert-dismissible.fade.show(role='alert')
          | #{success}
          button.btn-close(type='button', data-bs-dismiss='alert', aria-label='Close')
      if error
        .alert.alert-danger.alert-dismissible.fade.show(role='alert')
          | #{error}
          button.btn-close(type='button', data-bs-dismiss='alert', aria-label='Close')
      block content

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js')

