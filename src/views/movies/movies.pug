extends ../layout

block content
  .container.mt-5
    .d-flex.justify-content-between.align-items-center.mb-3
      h2.text-center.mb-0 FilmOverzicht
      a.btn.btn-primary(href='/movies/add') Voeg film toe
    .row.g-4
      each movie in movies
        .col-lg-3.col-md-4.col-sm-6
          .card.h-100.shadow-sm
            h5.card-header.bg-dark.text-white #{movie.title}
            .card-body
              h5.card-title #{movie.genre || 'Genre onbekend'}
              p.card-text #{movie.description || 'Geen beschrijving beschikbaar.'}
              .d-flex.justify-content-between.mt-3
                a.btn.btn-primary(href=`/movies/${movie.film_id}/details`) Details
                button.btn.btn-danger(type='button', onclick=`buttonClick(${movie.film_id}, this)`) Delete
    .d-flex.justify-content-center.align-items-center.mt-4
      button#moviePagePrev.btn.btn-secondary.mx-2(type='button') Vorige
      span.mx-2
        | Pagina 
        span#moviePageCurrent 1
        |  van 
        span#moviePageTotal 1
      button#moviePageNext.btn.btn-secondary.mx-2(type='button') Volgende
  script(src='/javascripts/delete.movie.js')
  script(src='/util/moviePage.js')

